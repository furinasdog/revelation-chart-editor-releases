<Application x:Class="RevelationHub.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#F0F2F4"/>
    <SolidColorBrush x:Key="Muted" Color="#ACB4C0"/>
    <SolidColorBrush x:Key="Gold" Color="#F3C654"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="Button">
      <EventSetter Event="MouseEnter" Handler="ButtonMotion"/>
      <EventSetter Event="MouseLeave" Handler="ButtonMotion"/>
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ButtonPress"/>
      <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ButtonPress"/>
      <Setter Property="RenderTransformOrigin" Value=".5,.5"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="#333941"/>
      <Setter Property="Padding" Value="15,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="edge" CornerRadius="4" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="edge" Property="Opacity" Value=".84"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="edge" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="edge" Property="Opacity" Value=".50"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
