<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RevelationHub</AssemblyName>
    <RootNamespace>RevelationHub</RootNamespace>
    <ApplicationIcon>assets/Revelation.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <AssemblyTitle>更好的制谱器Hub</AssemblyTitle>
    <Product>更好的制谱器Hub</Product>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LibrarySmoke" />
    <Compile Remove="tests/**/*.cs"/>
    <None Remove="tests/**"/>
    <Resource Include="assets/Revelation.ico" />
    <EmbeddedResource Include="publisher.xml" />
    <EmbeddedResource Include="catalog.signed.json" />
    <EmbeddedResource Include="manifests/*.json" LogicalName="RevelationHub.manifests.%(Filename)%(Extension)" />
    <EmbeddedResource Include="assets/model-files.json" />
    <EmbeddedResource Include="guides/*.md" LogicalName="RevelationHub.guides.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
