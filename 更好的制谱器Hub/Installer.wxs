<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="更好的制谱器 Hub" Manufacturer="Revelation Hub" Version="1.5.1" UpgradeCode="D7B58CEC-A20B-4241-AB97-718966748E29" Language="2052" Codepage="936" Scope="perUser" InstallerVersion="500">
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="已安装更高版本的制谱器 Hub。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="medium" />
    <Icon Id="RevelationHub.ico" SourceFile="$(sys.SOURCEFILEDIR)assets\Revelation.ico"/>
    <Property Id="ARPPRODUCTICON" Value="RevelationHub.ico"/>
    <StandardDirectory Id="ProgramMenuFolder"/>
    <StandardDirectory Id="DesktopFolder"/>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDirectory" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="RevelationHub">
          <Component Id="HubApp" Guid="6D2D9E72-97F3-4B3F-B8B0-CBBD415B6F43">
            <File Id="HubExe" Source="$(var.PublishDir)\RevelationHub.exe"/>
            <File Id="GplLicense" Source="$(var.LicenseFile)" Name="LICENSE.txt"/>
            <File Id="RuntimeLicense" Source="$(sys.SOURCEFILEDIR)licenses\dotnet-LICENSE.txt"/>
            <File Id="WpfLicense" Source="$(sys.SOURCEFILEDIR)licenses\windowsdesktop-LICENSE.txt"/>
            <File Id="RuntimeNotices" Source="$(sys.SOURCEFILEDIR)licenses\dotnet-THIRD-PARTY-NOTICES.txt"/>
            <RemoveFile Id="RemoveStartMenu" Directory="ProgramMenuFolder" Name="更好的制谱器 Hub.lnk" On="uninstall"/>
            <RemoveFile Id="RemoveDesktop" Directory="DesktopFolder" Name="更好的制谱器 Hub.lnk" On="uninstall"/>
            <RemoveFolder Id="RemoveHubFolder" Directory="INSTALLFOLDER" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\RevelationHub" Name="Installed" Type="integer" Value="1" KeyPath="yes"/>
            <RegistryValue Root="HKCU" Key="Software\RevelationHub" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]"/>
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <Feature Id="Main" Title="更好的制谱器 Hub"><ComponentRef Id="HubApp"/></Feature>
    <Property Id="HUBSTART" Value="1"/>
    <Property Id="DefaultUIFont" Value="HubFont"/>
    <CustomAction Id="SetShortcuts" FileRef="HubExe" ExeCommand="--set-shortcuts &quot;start=[HUBSTART]&quot; &quot;desktop=[HUBDESKTOP]&quot;" Return="check"/>
    <CustomAction Id="RestoreShortcuts" FileRef="HubExe" ExeCommand="--restore-shortcuts" Return="check"/>
    <UI>
      <TextStyle Id="HubFont" FaceName="Microsoft YaHei UI" Size="9"/>
      <TextStyle Id="HubTitle" FaceName="Microsoft YaHei UI" Size="13" Bold="yes"/>
      <Dialog Id="HubWelcome" Width="300" Height="150" Title="[ProductName] 安装" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="16" Y="14" Width="268" Height="22" Text="{\HubTitle}安装 [ProductName]"/>
        <Control Id="Info" Type="Text" X="16" Y="48" Width="268" Height="36" Text="点击「安装」将 v[ProductVersion] 安装到当前 Windows 账户，或更新已有版本。"/>
        <Control Id="Line" Type="Line" X="0" Y="112" Width="300" Height="1"/>
        <Control Id="Install" Type="PushButton" X="154" Y="123" Width="60" Height="18" Default="yes" Text="安装">
          <Publish Property="REINSTALL" Value="ALL" Condition="Installed" Order="1"/>
          <Publish Event="EndDialog" Value="Return" Order="2"/>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="224" Y="123" Width="60" Height="18" Cancel="yes" Text="取消">
          <Publish Event="EndDialog" Value="Exit"/>
        </Control>
      </Dialog>
      <Dialog Id="HubProgress" Width="300" Height="116" Title="[ProductName] 安装进度" Modeless="yes">
        <Control Id="Title" Type="Text" X="16" Y="14" Width="268" Height="22" TabSkip="no" Text="{\HubTitle}正在处理 [ProductName]"/>
        <Control Id="Stage" Type="Text" X="16" Y="46" Width="268" Height="20" Text="正在准备文件…">
          <Subscribe Event="ActionText" Attribute="Text"/>
        </Control>
        <Control Id="Progress" Type="ProgressBar" X="16" Y="76" Width="268" Height="12" ProgressBlocks="no" Text="0">
          <Subscribe Event="SetProgress" Attribute="Progress"/>
        </Control>
      </Dialog>
      <ProgressText Action="InstallFiles" Message="正在复制 Hub 文件…"/>
      <ProgressText Action="RegisterProduct" Message="正在注册应用…"/>
      <ProgressText Action="RemoveFiles" Message="正在移除文件…"/>
      <Dialog Id="HubFinished" Width="300" Height="155" Title="[ProductName]" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="14" Y="12" Width="268" Height="20" Text="{\HubTitle}安装完成"/>
        <Control Id="Prompt" Type="Text" X="14" Y="38" Width="268" Height="15" Text="选择添加快捷方式的位置"/>
        <Control Id="Start" Type="CheckBox" X="14" Y="59" Width="268" Height="15" Property="HUBSTART" CheckBoxValue="1" Text="添加到开始菜单"/>
        <Control Id="Desktop" Type="CheckBox" X="14" Y="81" Width="268" Height="15" Property="HUBDESKTOP" CheckBoxValue="1" Text="添加到桌面"/>
        <Control Id="Line" Type="Line" X="0" Y="117" Width="300" Height="1"/>
        <Control Id="Finish" Type="PushButton" X="228" Y="127" Width="58" Height="18" Default="yes" Cancel="yes" Text="完成">
          <Publish Event="DoAction" Value="SetShortcuts" Order="1"/>
          <Publish Event="EndDialog" Value="Return" Order="2"/>
        </Control>
      </Dialog>
    </UI>
    <InstallUISequence>
      <Show Dialog="HubWelcome" After="CostFinalize" Condition="NOT REMOVE~=&quot;ALL&quot; AND UILevel = 5"/>
      <Show Dialog="HubProgress" Before="ExecuteAction" Condition="UILevel &gt;= 4"/>
      <Show Dialog="HubFinished" OnExit="success" Condition="NOT REMOVE~=&quot;ALL&quot; AND UILevel = 5"/>
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="RestoreShortcuts" After="InstallFinalize" Condition="NOT REMOVE~=&quot;ALL&quot; AND UILevel &lt; 5"/>
    </InstallExecuteSequence>
  </Package>
</Wix>
