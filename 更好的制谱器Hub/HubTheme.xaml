<ResourceDictionary x:Class="RevelationHub.HubTheme" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <SolidColorBrush x:Key="Ink" Color="#303340"/>
    <SolidColorBrush x:Key="Muted" Color="#595E6F"/>
    <SolidColorBrush x:Key="Accent" Color="#536685"/>
    <SolidColorBrush x:Key="Rule" Color="#D7D9E0"/>
    <SolidColorBrush x:Key="Paper" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Canvas" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="StatusSurface" Color="#E4ECF4"/>
    <SolidColorBrush x:Key="StatusDivider" Color="#C9D5E1"/>
    <SolidColorBrush x:Key="Field" Color="#FCFCFD"/>
    <SolidColorBrush x:Key="FieldEdge" Color="#A4A8B5"/>
    <SolidColorBrush x:Key="SelectedFill" Color="#EBF1F8"/>
    <SolidColorBrush x:Key="HoverInk" Color="#66739A"/>
    <SolidColorBrush x:Key="Success" Color="#326451"/>
    <SolidColorBrush x:Key="Warning" Color="#8C482A"/>
    <SolidColorBrush x:Key="SyncSuccess" Color="#E2F3E9"/>
    <SolidColorBrush x:Key="SyncFailure" Color="#FCECE9"/>
    <LinearGradientBrush x:Key="TitleBackground" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#535E70" Offset="0"/><GradientStop Color="#687385" Offset=".55"/><GradientStop Color="#566173" Offset="1"/>
    </LinearGradientBrush>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="TransferStatus" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Paper}"/><Setter Property="BorderBrush" Value="{StaticResource Rule}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="18,16"/><Setter Property="Margin" Value="0,0,2,12"/>
    </Style>
    <Style x:Key="KeyboardFocusMark" TargetType="Control">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
        <Rectangle Width="16" Height="2" RadiusX="1" RadiusY="1" Fill="{StaticResource HoverInk}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" IsHitTestVisible="False"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ConfigTab" TargetType="TabItem">
      <Setter Property="Padding" Value="14,7,14,9"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusMark}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabFace" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabFace" Property="Background" Value="{StaticResource SelectedFill}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <ControlTemplate x:Key="ConfigTabs" TargetType="TabControl">
      <StackPanel>
        <Grid HorizontalAlignment="Left" Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <UniformGrid Grid.ColumnSpan="3" Rows="1" Columns="3" IsItemsHost="True" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle"/>
          <Border x:Name="SelectionMark" Height="2" CornerRadius="1" Background="{StaticResource Accent}" IsHitTestVisible="False" VerticalAlignment="Bottom" Margin="8,0,8,1"/>
        </Grid>
        <Border ClipToBounds="True">
          <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" KeyboardNavigation.TabNavigation="Local"/>
        </Border>
      </StackPanel>
    </ControlTemplate>
    <Style TargetType="Button">
      <EventSetter Event="MouseEnter" Handler="ButtonMotion"/><EventSetter Event="MouseLeave" Handler="ButtonMotion"/>
      <EventSetter Event="LostMouseCapture" Handler="ButtonMotion"/>
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ButtonPress"/><EventSetter Event="PreviewMouseLeftButtonUp" Handler="ButtonPress"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusMark}"/><Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="{StaticResource FieldEdge}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,5"/><Setter Property="MinHeight" Value="30"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid ClipToBounds="True">
          <Border x:Name="Face" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
          <Border x:Name="HoverFill" CornerRadius="3" Margin="2" Background="{StaticResource HoverInk}" Opacity="0" IsHitTestVisible="False"/>
          <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="p:Selector.IsSelected" Value="True"><Setter TargetName="Face" Property="Background" Value="{StaticResource SelectedFill}"/><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Margin" Value="4,2"/><Setter Property="MinHeight" Value="36"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid ClipToBounds="True" Background="Transparent">
          <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="4"/>
          <Border x:Name="HoverFill" Background="{StaticResource HoverInk}" Opacity="0" Margin="2" CornerRadius="3" IsHitTestVisible="False"/>
          <Border x:Name="Bar" HorizontalAlignment="Left" Margin="0,8" CornerRadius="1" Width="3" Background="{StaticResource Accent}" Visibility="Hidden"/>
          <StackPanel Orientation="Horizontal" Margin="13,0,4,0" VerticalAlignment="Center">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="{TemplateBinding CommandParameter}" Width="24" VerticalAlignment="Center"/>
            <ContentPresenter VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="p:Selector.IsSelected" Value="True"><Setter TargetName="Face" Property="Background" Value="{StaticResource SelectedFill}"/><Setter TargetName="Bar" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TopButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="13,3"/><Setter Property="Margin" Value="1,0"/>
      <Setter Property="MinHeight" Value="30"/><Setter Property="MinWidth" Value="63"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid ClipToBounds="True">
          <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="15"/>
          <Border x:Name="HoverFill" Background="#A9B1C8" Opacity="0" CornerRadius="13" Margin="2" IsHitTestVisible="False"/>
          <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="{TemplateBinding CommandParameter}" Margin="0,0,5,0" VerticalAlignment="Center"/>
            <ContentPresenter VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="p:Selector.IsSelected" Value="True"><Setter TargetName="Face" Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Width" Value="33"/><Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="{StaticResource FieldEdge}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CaretBrush" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="30"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="{StaticResource FieldEdge}"/><Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="30"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="{StaticResource FieldEdge}"/>
      <Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="30"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3"/>
          <ContentPresenter Margin="8,3,28,3" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
          <Path Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource Muted}" StrokeThickness="1.4" IsHitTestVisible="False"/>
          <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}">
            <Border Background="White" BorderBrush="{StaticResource FieldEdge}" BorderThickness="1" CornerRadius="3" Padding="2" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
              <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="8,4"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Option" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Option" Property="Background" Value="{StaticResource SelectedFill}"/></Trigger>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="{StaticResource Rule}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="White"/></Style>
    <ControlTemplate x:Key="ScrollTrackButton" TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
    <Style TargetType="ScrollBar"><Style.Triggers><Trigger Property="Orientation" Value="Vertical">
      <Setter Property="Width" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" IsEnabled="{TemplateBinding IsEnabled}">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Template="{StaticResource ScrollTrackButton}"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb MinHeight="16"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="2,1" Background="{StaticResource FieldEdge}" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Template="{StaticResource ScrollTrackButton}"/></Track.IncreaseRepeatButton>
        </Track></Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Trigger></Style.Triggers></Style>

</ResourceDictionary>
