<Window x:Class="RevelationHub.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="更好的制谱器Hub" Width="988" Height="640" MinWidth="700" MinHeight="480" WindowStartupLocation="CenterScreen" Background="#171A1E" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#101216" BorderThickness="0,0,1,0" BorderBrush="#2F343B" Padding="15,30">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="3,0,0,32">
            <Border Background="{StaticResource Gold}" Width="31" Height="31" CornerRadius="5"><Viewbox Margin="5"><Path Fill="#171A1E" Data="M 0,13 H 3 V 20 H 0 Z M 5,7 H 8 V 20 H 5 Z M 10,2 H 13 V 16 H 10 Z M 15,0 H 18 V 9 H 15 Z"/></Viewbox></Border>
            <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="制谱器 Hub"/>
          </StackPanel>
          <Button x:Name="LibraryTab" Content="版本库" Click="ShowLibrary" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
          <Button x:Name="InstalledTab" Content="已安装" Click="ShowInstalled" HorizontalContentAlignment="Left"/>
        </StackPanel>
        <Button DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Content="打开安装目录" Click="OpenFolder" ToolTip="在资源管理器中打开各版本的安装位置"/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="32,30">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,14"><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新版本" Click="RefreshClick" VerticalAlignment="Center"/><TextBlock x:Name="PageTitle" Text="版本库" FontSize="32" FontWeight="SemiBold"/></DockPanel>
      <TextBlock Grid.Row="1" x:Name="CatalogStatus" Foreground="{StaticResource Muted}" Margin="0,0,0,20" AutomationProperties.LiveSetting="Polite"/>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Cards"/></ScrollViewer>
      <TextBlock Grid.Row="3" x:Name="EmptyState" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
    </Grid>
  </Grid>
</Window>
