<Window x:Class="RevelationHub.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="更好的制谱器 Hub" Icon="assets/Revelation.ico" Width="990" Height="650" MinWidth="670" MinHeight="440" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="{x:Null}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True">

  <Border x:Name="WindowFrame" CornerRadius="8" SizeChanged="ClipWindowFrame"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Background="{StaticResource TitleBackground}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"><Image Source="assets/Revelation.ico" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="制谱器 Hub" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="White" FontSize="17" FontWeight="SemiBold"/></StackPanel>
      <StackPanel x:Name="Groups" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="启动" CommandParameter="&#xE768;" Style="{StaticResource TopButton}" Click="GroupClick"/>
        <Button Content="下载" CommandParameter="&#xE896;" Style="{StaticResource TopButton}" Click="GroupClick"/>
        <Button Content="设置" CommandParameter="&#xE713;" Style="{StaticResource TopButton}" Click="GroupClick"/>
        <Button Content="更多" CommandParameter="&#xECA5;" Style="{StaticResource TopButton}" Click="GroupClick"/>
      </StackPanel>
      <StackPanel x:Name="CaptionButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" HorizontalAlignment="Right" Margin="0,4,4,4">
        <Button x:Name="MinimizeButton" AutomationProperties.Name="最小化" Content="&#xE921;" Style="{StaticResource WindowButton}" Click="MinimizeClick" ToolTip="最小化"/>
        <Button AutomationProperties.Name="关闭 Hub" Content="&#xE8BB;" Style="{StaticResource WindowButton}" Click="CloseClick" ToolTip="关闭"/>
      </StackPanel>
    </Grid>
    <Grid x:Name="Workspace" Grid.Row="1" Background="{StaticResource Canvas}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="146"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Paper}" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,1,0" Padding="3,12,3,8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Separator Margin="12,5"/>
            <Button x:Name="FeedbackButton" Style="{StaticResource RailButton}" Content="问题反馈" CommandParameter="&#xE939;" Click="FeedbackClick"/>
            <Button Style="{StaticResource RailButton}" Content="安装目录" CommandParameter="&#xE8B7;" Click="OpenFolder"/>
            <TextBlock x:Name="HubVersionLabel" Foreground="{StaticResource Muted}" FontSize="12" Margin="18,9,0,2"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Navigation">
            <Button Content="已安装" Tag="启动" CommandParameter="&#xE768;" Style="{StaticResource RailButton}" Click="NavigateClick" Visibility="Collapsed"/>
            <Button Content="版本库" Tag="下载" CommandParameter="&#xE7B8;" Style="{StaticResource RailButton}" Click="NavigateClick"/>
            <Button Content="模型管理" Tag="下载" CommandParameter="&#xE950;" Style="{StaticResource RailButton}" Click="NavigateClick"/>
            <Button Content="编辑器配置" Tag="设置" CommandParameter="&#xE9E9;" Style="{StaticResource RailButton}" Click="NavigateClick" Visibility="Collapsed"/>
            <Button Content="Hub 设置" Tag="设置" CommandParameter="&#xE713;" Style="{StaticResource RailButton}" Click="NavigateClick" Visibility="Collapsed"/>
            <Button Content="参考工程" Tag="更多" CommandParameter="&#xE8F1;" Style="{StaticResource RailButton}" Click="NavigateClick" Visibility="Collapsed"/>
            <Button Content="使用文档" Tag="更多" CommandParameter="&#xE82D;" Style="{StaticResource RailButton}" Click="NavigateClick" Visibility="Collapsed"/>
          </StackPanel></ScrollViewer>
        </DockPanel>
      </Border>
      <Border x:Name="StatusBackdrop" Grid.Column="1" VerticalAlignment="Bottom" Height="{Binding ActualHeight, ElementName=JobPanel}"
              Background="{StaticResource StatusSurface}" BorderBrush="{StaticResource StatusDivider}" BorderThickness="0,1,0,0" IsHitTestVisible="False"/>
      <Grid Grid.Column="1" Margin="24,18,18,0" x:Name="ContentArea">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,4,10"><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新版本" Click="RefreshClick" VerticalAlignment="Center"/><TextBlock x:Name="PageTitle" Text="版本库" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <Grid Grid.Row="1" ClipToBounds="True">
          <ScrollViewer x:Name="LibraryBody" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,4,0">
            <StackPanel x:Name="Cards"/><TextBlock x:Name="EmptyState" Foreground="{StaticResource Muted}" Margin="0,5,0,4"/>
          </StackPanel></ScrollViewer>
          <ScrollViewer x:Name="ManagerBody" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Manager" Margin="0,0,4,0"/></ScrollViewer>
        </Grid>
        <Grid x:Name="JobPanel" Grid.Row="2" Margin="0,0,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="JobStatus" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          <ProgressBar x:Name="JobProgress" Grid.Column="1" Visibility="Collapsed" Width="80" Height="4" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource Accent}"/>
          <Button x:Name="JobCancel" Grid.Column="2" Visibility="Collapsed" Content="取消" Padding="8,1" MinHeight="24" VerticalAlignment="Center" Click="CancelJob"/>
          <Button x:Name="ApplyButton" Grid.Column="3" Content="重启并更新" Padding="8,1" MinHeight="24" VerticalAlignment="Center" Click="ApplyClick" Visibility="Collapsed"/>
        </Grid>
      </Grid>
    </Grid>
    <Canvas Grid.Row="1" ClipToBounds="True" IsHitTestVisible="False">
      <StackPanel x:Name="HintStack" Canvas.Right="0" Canvas.Bottom="44" HorizontalAlignment="Right">
        <StackPanel x:Name="RecentHints"/>
      <Border x:Name="SyncHint" HorizontalAlignment="Right" Padding="16,7,13,7" MaxWidth="360" CornerRadius="6,0,0,6" BorderThickness="0,0,3,0" Visibility="Collapsed">
        <TextBlock x:Name="SyncHintText" FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </Border>
      </StackPanel>
    </Canvas>
    <Grid x:Name="FeedbackOverlay" Grid.RowSpan="2" Background="#30242E40" Visibility="Collapsed"
          KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="FeedbackKeyDown">
      <Border x:Name="FeedbackCard" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" Padding="24,20"
              Background="{StaticResource Paper}" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="8" AutomationProperties.Name="问题反馈">
        <StackPanel>
          <TextBlock Text="问题反馈" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock Text="请在制谱师/企划群中 @短夜月 反馈" Margin="0,14,0,20"/>
          <Button x:Name="FeedbackOk" Content="知道了" HorizontalAlignment="Right" MinWidth="78" IsDefault="True" Click="DismissFeedback"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid></Border>
</Window>
